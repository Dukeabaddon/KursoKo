{
  "name": "kursoko-career-assessment",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "knip": "knip",
    "assets:landing": ".venv-assets/bin/python scripts/generate-landing-placeholders.py",
    "assets:prep": ".venv-assets/bin/python scripts/questionnaire-asset-queue.py prep",
    "assets:next": ".venv-assets/bin/python scripts/questionnaire-asset-queue.py next",
    "assets:install": ".venv-assets/bin/python scripts/questionnaire-asset-queue.py install",
    "assets:strip": ".venv-assets/bin/python scripts/questionnaire-asset-queue.py strip",
    "assets:process": ".venv-assets/bin/python scripts/questionnaire-asset-queue.py process",
    "assets:status": ".venv-assets/bin/python scripts/questionnaire-asset-queue.py status",
    "drawbridge:install": "test -d .tools/drawbridge || git clone --depth 1 https://github.com/Dukeabaddon/drawbridge.git .tools/drawbridge",
    "drawbridge:extension-path": "node -e \"console.log(require('path').resolve('.tools/drawbridge/chrome-extension'))\""
  },
  "dependencies": {
    "@heroicons/react": "^2.1.5",
    "framer-motion": "^12.42.2",
    "html-to-image": "^1.11.13",
    "lenis": "^1.3.25",
    "lucide-react": "^1.18.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "knip": "^6.23.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.14",
    "vite": "^7.0.4"
  }
}
