{
  "$comment": "Template for questionnaire choice prompts — source of truth is each qNN.M.json file, not Python.",
  "schema_version": 3,
  "required_blocks": [
    "questionnaire",
    "deliverable",
    "art_style",
    "color",
    "lighting",
    "pose",
    "clothes",
    "subject",
    "composition",
    "technical",
    "generation",
    "prompt_for_image_ai"
  ],
  "global_rules": {
    "style": "flat vector scene illustration, 2px #2D2D2D outline",
    "people": "hands and forearms only — no faces, no identifiable people",
    "locale": "neutral global",
    "forbidden_on_image": [
      "RIASEC letter",
      "border frame or sticker card",
      "text labels or captions",
      "full faces",
      "photorealistic or 3D render",
      "SaaS dashboard UI",
      "distressing imagery"
    ],
    "size_px": "640x640 transparent PNG",
    "output_dir": "src/assets/questionnaire/"
  },
  "riasec_palette": {
    "R": { "type": "Realistic", "accent": "#4DB6AC", "secondary": "#9575CD" },
    "I": { "type": "Investigative", "accent": "#4B2C7F", "secondary": "#4DB6AC" },
    "A": { "type": "Artistic", "accent": "#FFD54F", "secondary": "#9575CD" },
    "S": { "type": "Social", "accent": "#9575CD", "secondary": "#4DB6AC" },
    "E": { "type": "Enterprising", "accent": "#FF8A65", "secondary": "#FFD54F" },
    "C": { "type": "Conventional", "accent": "#81D4FA", "secondary": "#4B2C7F" }
  },
  "sensitive_slots_symbolic_only": ["17.1", "19.2", "23.2", "24.1", "27.1"]
}
